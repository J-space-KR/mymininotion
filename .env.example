# 이 프로젝트에 필요한 환경변수 목록 (실제 값은 .env.local 에 적으세요)
# Claude Code Stop 훅(.claude/hooks/env-example.js)이 자동으로 갱신해요.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# 프로필 이미지 버킷(profile-image)의 공개 주소 — 버킷 이름까지가 앞부분이에요.
# 예: https://<프로젝트ref>.supabase.co/storage/v1/object/public/profile-image
# 뒷부분(<uuid>.jpg)은 profile 테이블의 "image-path" 컬럼에 저장돼요.
NEXT_PUBLIC_PROFILE_IMAGE_BASE_URL=
